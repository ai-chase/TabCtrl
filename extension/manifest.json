{
  "manifest_version": 3,
  "name": "TabCtrl",
  "version": "1.0.0",
  "description": "当标签页过载成为日常，TabCtrl帮你回到清晰。",
  "permissions": ["tabs", "activeTab", "storage", "sessions", "scripting", "bookmarks"],
  "host_permissions": ["<all_urls>"],
  "chrome_url_overrides": { "newtab": "index.html" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "TabCtrl",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "undo-close": {
      "description": "Reopen the most recently closed tab(s)"
    }
  }
}
