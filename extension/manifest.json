{
  "manifest_version": 3,
  "name": "TabCtrl",
  "version": "1.0.0",
  "description": "Hand-drawn new tab page that turns tab overload into clarity: group by intent, archive cold tabs, undo your last close.",
  "permissions": ["tabs", "activeTab", "storage", "sessions", "scripting", "bookmarks"],
  "host_permissions": ["<all_urls>"],
  "chrome_url_overrides": { "newtab": "index.html" },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "TabCtrl",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "undo-close": {
      "description": "Reopen the most recently closed tab(s)"
    }
  }
}
